#include <stdio.h> 
int main(){ 
	int n,b[20],i; 
	printf("Enter number of e-book blocks: "); 
	scanf("%d",&n); 
	printf("Enter block numbers: "); 
	for(i=0;i<n;i++) scanf("%d",&b[i]); 
	printf("Index block -> "); 
	for(i=0;i<n;i++) printf("%d ",b[i]); 
	printf("\nE-book stored successfully.\n"); 
	return 0; 
} 
