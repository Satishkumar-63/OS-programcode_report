#include <stdio.h> 
#include <string.h> 
 
int main() { 
	char f[10][30], name[30]; 
	int n=0, ch, i, found; 
 
	do { 
    	printf("\n1.Create File  2.View Files  3.Exit\nChoice: "); 
    	scanf("%d",&ch); 
 
    	if(ch==1) { 
        	printf("Enter patient file: "); 
        	scanf("%s",name); 
        	found=0; 
 
        	for(i=0;i<n;i++) 
            	if(strcmp(f[i],name)==0) found=1; 
 
        	if(found) printf("File already exists!\n"); 
        	else { 
            	strcpy(f[n++],name); 
            	printf("File created successfully.\n"); 
        	} 
    	} 
    	else if(ch==2) { 
        	printf("Patient Files:\n"); 
        	for(i=0;i<n;i++) 
            	printf("%s\n",f[i]); 
    	} 
	} while(ch!=3); 
 
	return 0; 
} 
