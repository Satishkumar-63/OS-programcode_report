#include <bits/stdc++.h> 
using namespace std; 
int main() { 
	int a[] = {82, 170, 43, 140, 24, 16, 190}, head = 50; 
	int n = 7, total = 0; 
	bool used[7] = {}; 
	cout << "Sequence: " << head; 
	for (int k = 0; k < n; k++) { 
    	int pos = -1, mn = INT_MAX; 
    	for (int i = 0; i < n; i++) 
        	if (!used[i] && abs(head-a[i]) < mn) 
            	mn = abs(head-a[i]), pos = i; 
    	used[pos] = true; total += mn; head = a[pos]; 
    	cout << " -> " << head; 
	} 
	cout << "\nTotal Head Movement = " << total << endl; 
}  
